# Site settings for Leonardo, as shell variable assignments.
# Copy the account into an untracked site/local.env; never commit the real account here.

# Slurm account to charge (placeholder; set the real one in site/local.env).
SLURM_ACCOUNT="<YOUR_ACCOUNT>"

# Partition for the benchmark jobs.
SLURM_PARTITION="boost_usr_prod"

# Quality of service.
SLURM_QOS="normal"

# The cluster name SbatchMan files configs under; env.sh exports it.
SBATCHMAN_CLUSTER_NAME="leonardo"

# Laptop role only, all optional: put them in the untracked site/local.env, never here.
# install.sh --role laptop prints them in its dashboard and sbatchman fetch help (the flags
# --login-host, --user and --remote-dir win over them).
#   SITE_LOGIN_HOST   the cluster's login host
#   SITE_USER         your user on the cluster
#   SITE_REMOTE_DIR   the umbrella's folder on the cluster
