# Site settings for Leonardo, as shell variable assignments.
# Copy the account into an untracked site/local.env; never commit the real account here.

# Slurm account to charge (placeholder; set the real one in site/local.env).
SLURM_ACCOUNT="<YOUR_ACCOUNT>"

# Partition for the benchmark jobs.
SLURM_PARTITION="boost_usr_prod"

# Quality of service.
SLURM_QOS="normal"
