! Quantum ESPRESSO cp.x input: 128-atom silicon supercell (20.52 x 20.52 x 41.04 bohr), ecutwfc = 30, 250 steps of damped electron dynamics.
! On one Leonardo node with 4 GPUs one run takes about 20 seconds; change nstep, the supercell or ecutwfc to change the run time.
! cp.x writes a restart folder of about 190 MB (disk_io = 'none' does not stop it); "retain_files": false removes it with the run folder of a successful run.
&CONTROL
  title = 'Si 128 atoms, cp.x damped electrons',
  calculation = 'cp',
  restart_mode = 'from_scratch',
  ndr = 50,
  ndw = 50,
  nstep = 250,
  iprint = 50,
  isave = 1000,
  prefix = 'si',
  outdir = './scratch/',
  pseudo_dir = './pseudo/',
  verbosity = 'medium'
/
&SYSTEM
  ibrav = 0,
  nat = 128,
  ntyp = 1,
  nbnd = 256,
  ecutwfc = 30.0
/
&ELECTRONS
  emass = 400.d0,
  emass_cutoff = 2.5d0,
  orthogonalization = 'ortho',
  electron_dynamics = 'damp',
  electron_damping = 0.2,
  electron_velocities = 'zero',
  ortho_max = 30
/
&IONS
  ion_dynamics = 'none'
/
ATOMIC_SPECIES
Si 28.086 Si.pz-vbc.UPF
CELL_PARAMETERS bohr
20.5200 0.0000 0.0000
0.0000 20.5200 0.0000
0.0000 0.0000 41.0400
ATOMIC_POSITIONS crystal
Si 0.00000000 0.00000000 0.00000000
Si 0.00000000 0.25000000 0.12500000
Si 0.25000000 0.00000000 0.12500000
Si 0.25000000 0.25000000 0.00000000
